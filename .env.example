# ============================================================
# MokioClaw 配置文件模板
# 使用方法：复制本文件为 .env，然后填写你的真实密钥。
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交到版本库，保护个人隐私。
# ============================================================

# ---- OpenAI 兼容 LLM（必填）----
# API 密钥，获取地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# 自定义 API 端点（可选）。留空或注释掉则使用 OpenAI 官方端点。
# 使用第三方中转/兼容服务（如 Azure、DeepSeek、Moonshot 等）时填写对应 base_url。
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名（可选，默认 gpt-4o）。可换成 gpt-4o-mini / deepseek-chat 等。
MODEL=gpt-4o

# ---- Tavily 联网搜索（可选）----
# 用于 searchAgent 的 WebSearchTool。获取地址：https://tavily.com
# 未配置时，涉及联网搜索的任务会报错（其余功能不受影响）。
TAVILY_API_KEY=tvly-your-key-here

# ---- 上下文压缩阈值（可选）----
# 当估算的 token 数达到该值（默认 400000）时触发上下文压缩。
MOKIO_CONTEXT_TOKEN_LIMIT=400000
